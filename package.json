{
  "name": "galaxio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Galaxio — plugin marketplace for Cursor, Claude Code and Codex",
  "license": "Apache-2.0",
  "repository": "https://github.com/galax-io/ai-plugins",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-manifests.mjs",
    "check": "node scripts/check-all.mjs",
    "check:version-bump": "node scripts/check-version-bump.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint:md": "markdownlint-cli2",
    "spell": "cspell --no-progress --no-must-find-files \"**/*.{md,json,mjs}\"",
    "format": "prettier --write \"**/*.{json,jsonc,md}\"",
    "format:check": "prettier --check \"**/*.{json,jsonc,md}\""
  },
  "devDependencies": {
    "cspell": "^10.0.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.4.2"
  }
}
